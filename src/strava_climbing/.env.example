# Leave both blank (or unset STRAVA_CLIMBING_BACKEND) to run fully locally
# against SQLite + the filesystem. No Supabase project required.
NEXT_PUBLIC_SUPABASE_URL=your-url-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-key-here
# Optional — required for pipeline writes if RLS is enabled on your tables.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional — force a backend regardless of credentials.
# STRAVA_CLIMBING_BACKEND=supabase   # or "sqlite"
