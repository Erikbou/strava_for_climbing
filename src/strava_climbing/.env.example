NEXT_PUBLIC_SUPABASE_URL=your-url-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-key-here
# Optional — required for pipeline writes if RLS is enabled on your tables.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — Supabase Storage buckets for video blobs. Create the buckets
# in Supabase Dashboard → Storage; the pipeline does not auto-create them.
# Leaving these unset keeps videos local-only (data/raw, data/normalized,
# data/overlays); setting them publishes the corresponding stage to Storage.
# SUPABASE_STORAGE_RAW_BUCKET=videos-raw
# SUPABASE_STORAGE_NORMALIZED_BUCKET=videos-normalized
# SUPABASE_STORAGE_OVERLAYS_BUCKET=videos-overlays
